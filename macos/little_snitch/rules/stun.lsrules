{
    "name": "STUN",
    "description": "STUN / WebRTC services",
    "rules": [
        {
            "action": "allow",
            "process": "/Applications/Firefox.app/Contents/MacOS/firefox",
            "protocol": "udp",
            "ports": "19302",
            "owner": "me",
            "remote-hosts": "stun.cloudflare.com"
        },
        {
            "action": "allow",
            "process": "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
            "protocol": "udp",
            "ports": "19302",
            "owner": "me",
            "remote-hosts": "stun.cloudflare.com"
        },
        {
            "action": "allow",
            "process": "/Applications/Firefox.app/Contents/MacOS/firefox",
            "protocol": "udp",
            "ports": "3478",
            "owner": "me",
            "remote-hosts": [
                "stun.l.google.com",
                "stun1.l.google.com"
            ]
        },
        {
            "action": "allow",
            "process": "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
            "protocol": "udp",
            "ports": "3478",
            "owner": "me",
            "remote-hosts": [
                "stun.l.google.com",
                "stun1.l.google.com"
            ]
        },
        {
            "action": "allow",
            "process": "/Applications/Firefox.app/Contents/MacOS/firefox",
            "protocol": "udp",
            "ports": "3478",
            "owner": "me",
            "notes": "Zoom",
            "remote-addresses": "144.195.0.0/16,147.124.96.0/19,170.114.0.0/16,173.231.92.0/24,206.247.0.0/16"
        },
        {
            "action": "allow",
            "process": "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
            "protocol": "udp",
            "ports": "3478",
            "owner": "me",
            "notes": "Zoom",
            "remote-addresses": "144.195.0.0/16,147.124.96.0/19,170.114.0.0/16,173.231.92.0/24,206.247.0.0/16"
        }
    ]
}